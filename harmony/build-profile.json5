{
  "app": {
    "signingConfigs": [
      {
        "name": "liberadebug",
        "type": "HarmonyOS",
        "material": {
          "certpath": "./signing/app-sign-cert.cer",
          "storeFile": "./signing/librera-sign.p12",
          "profile": "./signing/librera-debug.p7b",
          "keyAlias": "app-sign-key",
          "keyPassword": "0000001CD32150AB3AFBD4334E54E997DE951904CA55261F289C6C80A0FEBBFECA6B9295872C498CD270AA99",
          "storePassword": "0000001CD32150AB3AFBD4334E54E997DE951904CA55261F289C6C80A0FEBBFECA6B9295872C498CD270AA99",
          "signAlg": "SHA256withECDSA"
        }
      }
    ],
    "products": [
      {
        "name": "default",
        "signingConfig": "liberadebug",
        "compatibleSdkVersion": "6.1.1(24)",
        "runtimeOS": "HarmonyOS",
        "buildOption": {
          "strictMode": {
            "caseSensitiveCheck": true,
            "useNormalizedOHMUrl": true
          }
        },
        "targetSdkVersion": "6.1.1(24)"
      }
    ],
    "buildModeSet": [
      {
        "name": "debug"
      },
      {
        "name": "release"
      }
    ]
  },
  "modules": [
    {
      "name": "entry",
      "srcPath": "./entry",
      "targets": [
        {
          "name": "default"
        }
      ]
    }
  ]
}