<?xml version="1.0" encoding="utf-8"?>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/parentParent"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <View
        android:id="@+id/systemBarHack"
        android:layout_width="match_parent"
        android:layout_height="0dp" />

    <FrameLayout
        android:id="@+id/adFrame1"
        android:visibility="gone"
        android:layout_marginTop="2dip"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />


    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/swipeRefreshLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical">


        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <androidx.drawerlayout.widget.DrawerLayout
                android:id="@+id/drawer_layout"
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical">

                    <LinearLayout
                        android:id="@+id/imageParent1"
                        android:layout_width="match_parent"
                        android:layout_height="48dip"
                        android:background="#0000ff"
                        android:orientation="horizontal">

                        <ImageView
                            android:id="@+id/imageMenu1"

                            android:layout_width="40dip"
                            android:visibility="visible"
                            android:layout_height="match_parent"
                            android:layout_marginLeft="10dip"
                            android:background="?android:attr/selectableItemBackground"
                            android:contentDescription="@string/menu"
                            android:gravity="center"
                            android:padding="4dip"
                            android:src="@drawable/glyphicons_600_menu"
                            android:tint="@color/white" />

                        <TextView
                            android:id="@+id/topBarTitle"
                            android:layout_width="0dip"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:ellipsize="end"
                            android:gravity="center_vertical"
                            android:paddingLeft="6dip"
                            android:singleLine="true"
                            android:text="@string/library"
                            android:textColor="@color/white"
                            android:textSize="18sp"
                            android:textStyle="bold" />

                        <ImageView
                            android:id="@+id/onImportBooks"
                            android:layout_width="44dip"
                            android:layout_height="match_parent"
                            android:background="?android:attr/selectableItemBackground"
                            android:contentDescription="@string/cd_import"
                            android:gravity="center"
                            android:padding="10dip"
                            android:src="@drawable/glyphicons_371_plus"
                            android:tint="@color/white" />

                        <com.foobnix.pdf.SlidingTabLayout
                            android:id="@+id/slidingTabs1"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_weight="0"
                            android:background="#3949ab"
                            android:elevation="2dip"
                            android:visibility="gone" />


                    </LinearLayout>




                    <!-- pager wrapped in a FrameLayout so the "continue last
                         book" floating button can float bottom-right over the
                         page content, ending exactly above the tab strip -->
                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="0dip"
                        android:layout_weight="1">

                        <androidx.viewpager.widget.ViewPager
                            android:id="@+id/pager"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent" />

                        <ImageView
                            android:id="@+id/fabLastBook"
                            android:layout_width="56dip"
                            android:layout_height="56dip"
                            android:layout_gravity="bottom|end"
                            android:layout_margin="16dip"
                            android:background="@drawable/fab_book_bg"
                            android:elevation="6dip"
                            android:padding="15dip"
                            android:src="@drawable/glyphicons_589_book_open"
                            android:visibility="gone" />

                        <!-- temporary host for drawer navigation to pages
                             that are disabled in the tab bar (decoupled:
                             the tab bar itself is not modified) -->
                        <FrameLayout
                            android:id="@+id/overlayContainer"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:visibility="gone" />
                    </FrameLayout>

                    <FrameLayout
                        android:layout_marginTop="2dp"
                        android:layout_marginBottom="2dp"
                        android:id="@+id/adFrame2"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />

                    <com.foobnix.pdf.SlidingTabLayout
                        android:id="@+id/slidingTabs2"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_weight="0"
                        android:background="#3949ab"
                        android:elevation="2dip"
                        android:visibility="gone" />

                </LinearLayout>


                <LinearLayout
                    android:id="@+id/left_drawer"
                    android:layout_width="280dip"
                    android:layout_height="match_parent"
                    android:layout_gravity="start"
                    android:orientation="vertical">
                    <!-- background is set in code per theme (light/dark/OLED/ink) -->

                    <!-- Moon+ style banner header -->
                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <!-- day/night photo swapped in code per theme (buildDrawerNavHeader) -->
                        <ImageView
                            android:id="@+id/drawerBanner"
                            android:layout_width="match_parent"
                            android:layout_height="170dip"
                            android:scaleType="centerCrop"
                            android:src="@drawable/drawer_banner_day" />

                        <!-- brand tagline, centered on the banner -->
                        <TextView
                            android:id="@+id/drawerTagline"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:gravity="center"
                            android:maxLines="1"
                            android:text="值得读，好好读"
                            android:textColor="#FFFFFF"
                            android:textSize="32sp"
                            android:textStyle="bold"
                            android:shadowColor="#88000000"
                            android:shadowDx="0"
                            android:shadowDy="1"
                            android:shadowRadius="4" />
                    </FrameLayout>

                    <!-- scrollable nav area: keeps the bottom action bar reachable
                         on short/landscape screens -->
                    <ScrollView
                        android:layout_width="match_parent"
                        android:layout_height="0dip"
                        android:layout_weight="1"
                        android:fillViewport="true"
                        android:overScrollMode="never">

                        <LinearLayout
                            android:id="@+id/drawerNavHeader"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical" />
                    </ScrollView>

                    <!-- random reading quote, refreshed on every drawer open;
                         floats three text lines above the bottom action bar
                         (settings/about/etc.). Text color is set in code per
                         day/night theme. -->
                    <TextView
                        android:id="@+id/drawerQuote"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="66dip"
                        android:gravity="start|center_vertical"
                        android:paddingStart="12dip"
                        android:paddingLeft="12dip"
                        android:paddingTop="8dip"
                        android:paddingEnd="12dip"
                        android:paddingRight="12dip"
                        android:paddingBottom="8dip"
                        android:textSize="19sp"
                        android:lineSpacingExtra="3dip" />

                    <View
                        android:id="@+id/drawerNavDivider"
                        android:layout_width="match_parent"
                        android:layout_height="1dip"
                        android:background="#33999999" />

                    <include
                        android:id="@+id/drawerBottomBar"
                        layout="@layout/drawer_bottom_bar" />
                </LinearLayout>
            </androidx.drawerlayout.widget.DrawerLayout>


            <FrameLayout
                android:id="@+id/overlay"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="gone" />

            <TextView
                android:id="@+id/toastBrightnessText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:background="@drawable/bg_my_toast"
                android:drawableLeft="@drawable/glyphicons_232_sun"
                android:drawablePadding="10dip"
                android:drawableTint="@color/white"
                android:padding="12dip"
                android:text="@string/brightness"
                android:textColor="@color/white"
                android:textSize="16sp"
                android:textStyle="bold"
                android:visibility="visible" />


            <com.foobnix.pdf.info.view.MyProgressBar
                android:id="@+id/fab"
                android:layout_width="@dimen/wh_button_small"
                android:layout_height="@dimen/wh_button_small"
                android:layout_alignParentRight="true"
                android:layout_gravity="center_horizontal"
                android:layout_margin="4dip"
                android:background="@drawable/bg_circular"
                android:indeterminateDrawable="@drawable/my_progress" />


        </RelativeLayout>


    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>


</LinearLayout>