<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- AdMob entries: this manifest overlay is compiled into the ad-capable
         flavor only (pro, since 2026-09-09; src/admobAds is attached to it in
         app/build.gradle). The APPLICATION_ID must stay a VALID id (default =
         Google sample id) because play-services-ads injects MobileAdsInitProvider
         and an invalid id is a fatal crash at app start. The ad-UNIT ids default
         to EMPTY → AdMobAdsProvider's empty-ID guards keep all load/show calls
         no-ops (ads dormant). fdroid (src/noAds) never merges this overlay. -->
    <application>
        <meta-data
            android:name="com.google.android.gms.ads.APPLICATION_ID"
            android:value="${admobAppId}" />
        <meta-data
            android:name="librera.ADMOB_BANNER_ID"
            android:value="${admobBannerId}" />
        <meta-data
            android:name="librera.ADMOB_FULLSCREEN_ID"
            android:value="${admobFullId}" />
        <meta-data
            android:name="librera.ADMOB_REWARD"
            android:value="${admobRewardId}" />
    </application>

</manifest>
