# ---------- HarmonyOS ----------
# hvigor / ohpm build state
harmony/.hvigor/
harmony/oh_modules/
harmony/build/
harmony/entry/build/
harmony/entry/.cxx/
harmony/native/build-arm64-v8a/
harmony/native/build-x86_64/
# MuPDF cross-compile output is staged here from prebuilt/harmony or native builds
harmony/entry/libs/
# IDE / logs / scratch
harmony/.idea/
harmony/**/hilog*
harmony/build_output.txt
# local signing material: keep ONLY the whitelisted scripts + README
harmony/signing/*
!harmony/signing/gen_signing.sh
!harmony/signing/make_material.js
!harmony/signing/README.md
# Android signing: same policy - local material only, whitelist the README
/android/signing/*
!/android/signing/README.md
# stray signing copies in harmony root (never commit keys)
harmony/material/
harmony/*.p12
harmony/*.p7b
harmony/*.cer
harmony/*.csr

# vendored net protocol libs (SMB/SFTP online reading): pristine upstream sources,
# versions in prebuilt/harmony/net/VERSIONS.txt, re-fetch/rebuild via Builder/net-libs/
# — same convention as /Builder/mupdf*
/Builder/libsmb2/
/Builder/libssh2/
/Builder/openssl/

# native build intermediates (2026-09-19 cleanup)
*.o
*.d
/Builder/jni/obj/
/Builder/jni/libs/
/Builder/openssl/build-*
__pycache__/
*.pyc
*.bak_*

# ---------- Desktop (Compose) build artifacts (2026-11-01) ----------
# desktop 下任意深度的 build/ 产物目录(含 desktop/build、desktop/{app,core,engine}/build)
desktop/**/build/

# ---------- desktop-qt (Qt branch) build artifacts (2026-11-01) ----------
# Qt 分支交叉构建产物目录（build-mxe 内含 exe/dll/运行 data）
desktop-qt/build*/
# 2026-11-07 上库前补充：过程/产物路径（保留盘上文件，仅不入库）
/android/**/build/
ci/autotest/results/
ci/autotest-hmos/results/
docs/**/build/
/docs_listing.txt
/android/com_files.txt
/android/net_files.txt
